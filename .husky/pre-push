#!/usr/bin/env sh

changed_files="$(git diff --name-only @{u}...HEAD 2>/dev/null || git diff --name-only HEAD~1...HEAD 2>/dev/null || git diff --name-only HEAD)"

has_changed_files() {
  echo "$changed_files" | grep -q "^$1/"
}

run_test_in_app() {
  app_path="$1"
  app_name="$2"
  command="$3"

  if ! has_changed_files "$app_path"; then
    echo "[$app_name] No pushed changes. Skipping tests ▶️"
    return 0
  fi

  echo "[$app_name] Pushed changes found. Running npm run $command..."
  (
    cd "$app_path" || exit 1
    npm run "$command" || exit 1
  )
}

run_test_in_app "apps/lb-api" "LastBite API" test
run_test_in_app "apps/lb-merchant" "LastBite Merchant" test:unit

if has_changed_files "apps/lb-customer"; then
  echo "[LastBite Customer] Changes found, but no test script exists. Skipping tests ▶️"
fi

echo "[LastBite] Pre-push checks passed ✅"
