# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.host:password@aws-region.pooler.provider.com:port/postgres"
REDIS_URL=
AUTH_REFRESH_TOKEN_KEY="<base64-encoded-32-byte-key>"
APP_ENV=production
# Cognito Hosted UI / OAuth
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=replace-with-cognito-client-secret
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
CUSTOMER_APP_URL=
MERCHANT_APP_URL=
