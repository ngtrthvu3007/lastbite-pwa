# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.host:password@aws-region.pooler.provider.com:port/postgres"
REDIS_URL=
APP_ENV=production
# Cognito Hosted UI / OAuth (managed by Terraform in infra/cognito: ID, secret, domain via `terraform output`)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=replace-with-cognito-client-secret
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
APP_URL=http://localhost:5173
# Parent domain shared by the web and API hosts (e.g. example.com) so lb-web can read lb_signed_in. Leave empty locally.
COOKIE_DOMAIN=
